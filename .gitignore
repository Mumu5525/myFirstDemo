# ===== Unity 缓存/生成目录（不要上传）=====
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
MemoryCaptures/

# ===== IDE 自动生成 =====
.vs/
.idea/
.vscode/
*.csproj
*.sln

# ===== 系统文件 =====
.DS_Store
Thumbs.db

# ===== 只保留 Assets/Scripts，忽略 Assets 下其他所有内容 =====
/Assets/*
!/Assets/Scripts/

# ===== 忽略 Unity 项目配置和包管理（按需）=====
/ProjectSettings/
/Packages/

# ===== 保留 .gitignore 本身 =====
!/.gitignore
